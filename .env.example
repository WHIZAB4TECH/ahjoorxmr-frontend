# Stellar network. Supported values: testnet, mainnet. Defaults to testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional network identity and Soroban RPC overrides.
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# NEXT_PUBLIC_STELLAR_NETWORK_LABEL=Testnet
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional deployed savings-circle contract ID (Stellar contract address).
# NEXT_PUBLIC_CIRCLE_CONTRACT_ID=

# Optional Starknet RPC endpoint used to estimate gas fees.
# Gas fee estimation falls back to wallet/static estimates when unset.
NEXT_PUBLIC_STARKNET_RPC_URL=

# Select mock (default) or http. HTTP mode requires NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_ADAPTER=mock
# Base URL for the HTTP API. Required only when adapter is http.
NEXT_PUBLIC_API_URL=

# Endpoint periodically pinged to detect connectivity/reconnects. Defaults to "/".
NEXT_PUBLIC_HEARTBEAT_URL=

# Toggles the bank-transfer off-ramp payout option; set to "false" to hide it.
NEXT_PUBLIC_OFFRAMP_ENABLED=true

# Display name for the off-ramp partner shown in payout method UI.
NEXT_PUBLIC_OFFRAMP_PARTNER=Bank transfer partner

# NODE_ENV is set by Next.js. No server-only variables are currently required.
